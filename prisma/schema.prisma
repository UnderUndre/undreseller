datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PAID_REQUIRES_RESOLUTION
  CANCELLED
  FULFILLED
  PAYMENT_EXPIRED
}

enum ReservationStatus {
  HELD
  BOOKED
  RELEASED
  // 004 US1 FSM two-track values (spec-level CONFIRMED maps to BOOKED at the service boundary)
  PAYMENT_PENDING
  UNDERPAID
  PENDING_APPROVAL
  CANCELLED
  STAFF_REJECTED
}

enum PaymentMethod {
  PAY_ON_SITE
  TELEGRAM_STARS
  CRYPTO_GATEWAY
}

enum PaymentType {
  PAY_ON_SITE
  PREPAYMENT_ONLINE
}

enum PrepaymentTiming {
  IMMEDIATE
  AFTER_STAFF_APPROVAL
}

enum ExternalIntegration {
  NONE
  TELEGRAM_BUNDLE
  WHATSAPP
  NOWPAYMENTS
}

enum ConfirmationStatus {
  PENDING_STAFF_REVIEW
  STAFF_APPROVED
  CLIENT_CONFIRMED
  RESCHEDULE_OFFERED
}

enum CancellationReason {
  CLIENT_DECLINED
  STAFF_REJECTED
  PAYMENT_EXPIRED
  CLIENT_BLOCKED
  AUTO_CANCELLED_NO_CONFIRMATION
  ADMIN_CANCELLED
}

enum RefundStatus {
  NONE
  REFUND_REQUESTED
  REFUNDED
}

enum RefundOperationKind {
  TELEGRAM_STARS_REFUND
  CRYPTO_REIMBURSEMENT
}

enum RefundOperationStatus {
  REQUESTED
  SUBMITTED
  CONFIRMED
  FAILED
  UNKNOWN
}

enum MessengerPlatform {
  TELEGRAM
  WHATSAPP
}

enum InboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum InboxEventKind {
  TELEGRAM_UPDATE
  WHATSAPP_MESSAGE
  NOWPAYMENTS_WEBHOOK
  SYSTEM_ALERT
  TELEGRAM_OUTBOUND
  STAFF_BOT_OUTBOUND
}

enum StaffRole {
  OWNER
  OPERATOR
  PERFORMER
}

enum ServiceFulfillmentMode {
  IN_CALL
  OUT_CALL
}

// -------------------------------------------------------------
// Better Auth Core Tables (Library-managed identity and sessions)
// -------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// -------------------------------------------------------------
// Staff, Access Control & Audit
// -------------------------------------------------------------

model StaffMember {
  id                  String               @id @default(uuid())
  authUserId          String               @unique // Better Auth user ID
  displayName         String
  role                StaffRole            @default(PERFORMER)
  telegramUserId      String?              @unique // Reserved for a later messaging integration
  resourceId          String?              @unique // Any bookable staff member can own a Resource, including OWNER
  resource            Resource?            @relation(fields: [resourceId], references: [id])
  professionalProfile ProfessionalProfile?
  invitedById         String?
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([role, active])
}

model AuditEvent {
  id            String     @id @default(uuid())
  action        String // e.g. "STAFF_MEMBER_PROVISIONED", "STAFF_SESSIONS_REVOKED", "BOOKING_STATUS_UPDATED"
  actorId       String // StaffMember.id, "BREAK_GLASS_ADMIN_TOKEN", or "CUSTOMER_CANCELLATION_LINK"
  actorRole     StaffRole?
  aggregateType String // "STAFF_MEMBER" | "SHOP_SETTINGS" | "PROFESSIONAL_PROFILE" | "SERVICE" | "BOOKING"
  aggregateId   String
  reason        String? // PII-redacted before persistence (INV-010)
  metadataJson  Json       @default("{}") // PII-redacted
  createdAt     DateTime   @default(now())

  @@index([aggregateType, aggregateId, createdAt])
  @@index([actorId, createdAt])
}

model CurrencyMetadata {
  code      String   @id // ISO 4217 code or explicitly configured non-ISO code, e.g., XTR
  minorUnit Int // ISO 4217 exponent (e.g., JPY=0, USD=2, AMD=2, KWD=3)
  symbol    String
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Resource {
  id          String                  @id
  name        String
  kind        String                  @default("STAFF") // "STAFF" | "ROOM" | "EQUIPMENT"
  active      Boolean                 @default(true)
  staffMember StaffMember?
  exceptions  AvailabilityException[]
  createdAt   DateTime                @default(now())
}

model AvailabilityException {
  id         String   @id @default(uuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD in ShopSettings.timeZone
  isClosed   Boolean  @default(false)
  startMin   Int?
  endMin     Int?
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([resourceId, date])
}

model ProfessionalProfile {
  id             String                @id @default(uuid())
  staffMemberId  String                @unique
  staffMember    StaffMember           @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  slug           String                @unique
  headline       String?
  biography      String?
  photoUrl       String?
  isPublished    Boolean               @default(false)
  services       ProfessionalService[]
  portfolioItems PortfolioItem[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([isPublished, slug])
}

model ProfessionalService {
  professionalProfileId String
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  itemId                String
  item                  Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([professionalProfileId, itemId])
  @@index([itemId])
}

model PortfolioItem {
  id                    String              @id @default(uuid())
  professionalProfileId String
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  mediaUrl              String
  sortOrder             Int                 @default(0)
  isPublished           Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([professionalProfileId, isPublished, sortOrder])
}

// -------------------------------------------------------------
// Existing Models with Additive Deltas
// -------------------------------------------------------------

model ShopSettings {
  id                         Int                 @id @default(1)
  currency                   String // ISO 4217
  greeting                   String
  whatsappTemplateName       String
  slotGridStepMin            Int                 @default(30)
  confirmationNoticeHours    Int                 @default(24)
  autoCancelDeadlineHours    Int?                @default(6)
  autoCancelForNewClients    Boolean             @default(true)
  allowPayOnSite             Boolean             @default(true)
  prepaymentTiming           PrepaymentTiming    @default(IMMEDIATE)
  enabledExternalIntegration ExternalIntegration @default(TELEGRAM_BUNDLE)
  staffDestinationChatId     String?
  authorizedStaffUserIds     String[]            @default([])
  updatedAt                  DateTime            @updatedAt

  // 003.1 Additive business settings fields (FR-335, FR-338)
  businessName                  String?
  businessDescription           String?
  logoUrl                       String?
  publicContactLinksJson        Json     @default("[]")
  defaultLocale                 String   @default("en")
  enabledLocales                String[] @default(["en"])
  timeZone                      String   @default("UTC")
  currencyConfirmed             Boolean  @default(false)
  businessServiceAddress        String?
  businessServiceAddressPublic  Boolean  @default(false)
  outCallCoverageDescription    String?
  requireStaffApprovalForInCall Boolean  @default(false)
}

model Item {
  id           String            @id @default(uuid())
  slug         String            @unique
  title        String
  description  String
  priceMinor   Int
  starsPrice   Int?
  currency     String
  imageUrl     String?
  itemType     ItemType
  stock        Int? // null only for SERVICE
  durationMin  Int?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  orderItems   OrderItem[]
  reservations SlotReservation[]
  hours        WeeklyHours[]

  // 003.1 Additive service fields (FR-338, FR-339)
  // 004 US9/US1 additions (data-model 1.8)
  requiresFullPrepayment  Boolean               @default(false)
  archivedAt              DateTime?             @db.Timestamptz(3)
  sortOrder               Int                   @default(0)
  bufferBeforeMin         Int                   @default(0)
  bufferAfterMin          Int                   @default(0)
  cancellationCutoffHours Int                   @default(3)
  inCallEnabled           Boolean               @default(true)
  outCallEnabled          Boolean               @default(false)
  outCallPriceMinor       Int?
  outCallTravelFeeMinor   Int                   @default(0)
  outCallTravelBeforeMin  Int                   @default(0)
  outCallTravelAfterMin   Int                   @default(0)
  professionalServices    ProfessionalService[]

  // 004 relations (data-model 1.3, 1.5)
  waitlistEntries     WaitlistEntry[]
  customBookingFields CustomBookingField[]
}

model WeeklyHours {
  id            String  @id @default(uuid())
  itemId        String?
  item          Item?   @relation(fields: [itemId], references: [id])
  resourceId    String  @default("default_master")
  weekday       Int // ISO 1–7
  startMin      Int
  endMin        Int
  breakStartMin Int?
  breakEndMin   Int?

  @@index([resourceId, weekday])
}

model SlotReservation {
  id                     String            @id @default(uuid())
  resourceId             String            @default("default_master")
  itemId                 String?
  item                   Item?             @relation(fields: [itemId], references: [id])
  orderId                String            @unique
  order                  Order             @relation(fields: [orderId], references: [id])
  startTime              DateTime          @db.Timestamptz(3)
  endTime                DateTime          @db.Timestamptz(3)
  totalDurationMin       Int
  status                 ReservationStatus
  holdExpiresAt          DateTime?         @db.Timestamptz(3)
  // 004 US1: set on first gateway `confirming`; suspends TTL sweep (hard ceiling 24h -> FR-432)
  holdFrozenAt           DateTime?         @db.Timestamptz(3)
  requiresOperatorAction Boolean           @default(false)
  operatorActionReason   String?
  createdAt              DateTime          @default(now())

  // 003.1 Additive cancellation credential & location snapshot fields (T005, T070)
  cancellationTokenHash       String?   @unique
  cancellationTokenExpiresAt  DateTime? @db.Timestamptz(3)
  cancellationTokenConsumedAt DateTime? @db.Timestamptz(3)
  cancellationTokenRevokedAt  DateTime? @db.Timestamptz(3)

  // 004 relations (data-model 1.4, 1.5)
  waitlistOffers      WaitlistOffer[]
  bookingFieldAnswers BookingFieldAnswer[]

  fulfillmentMode        ServiceFulfillmentMode?
  servicePriceMinor      Int?
  travelFeeMinor         Int?
  serviceAddressSnapshot String?
  appointmentStartTime   DateTime?               @db.Timestamptz(3)
  appointmentEndTime     DateTime?               @db.Timestamptz(3)
  bufferBeforeMin        Int                     @default(0)
  bufferAfterMin         Int                     @default(0)
  PaymentAllocationLink  PaymentAllocationLink[]

  @@index([resourceId, startTime, endTime])
}

model Order {
  id                         String                  @id @default(uuid())
  orderNumber                String                  @unique
  status                     OrderStatus             @default(PENDING)
  totalMinor                 Int
  currency                   String
  customerName               String?
  customerPhone              String?
  customerEmail              String?
  customerTgId               String?
  customerTgUsername         String?
  hasWhatsApp                Boolean                 @default(false)
  hasTelegram                Boolean                 @default(false)
  customerNotes              String?
  paymentType                PaymentType             @default(PAY_ON_SITE)
  confirmationStatus         ConfirmationStatus      @default(PENDING_STAFF_REVIEW)
  cancellationReason         CancellationReason?
  refundStatus               RefundStatus            @default(NONE)
  autoCancelOnNoConfirmation Boolean                 @default(false)
  scheduleVersion            Int                     @default(1)
  rescheduleTokenHash        String?
  rescheduleTokenConsumedAt  DateTime?               @db.Timestamptz(3)
  invoiceExpiresAt           DateTime?               @db.Timestamptz(3)
  reminderSentAt             DateTime?               @db.Timestamptz(3)
  staffMessageId             Int?
  staffChatId                String?
  requiresOperatorAction     Boolean                 @default(false)
  operatorActionReason       String?
  items                      OrderItem[]
  reservation                SlotReservation?
  refundOperations           RefundOperation[]
  orderLines                 OrderLine[]
  paymentAllocationLinks     PaymentAllocationLink[]
  paymentPlan                PaymentPlan?
  fulfillmentPlan            FulfillmentPlan?
  paymentMethod              PaymentMethod?
  paymentRef                 String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id])
  itemId           String
  item             Item    @relation(fields: [itemId], references: [id])
  titleSnapshot    String?
  currency         String  @default("USD")
  durationMin      Int?
  quantity         Int
  priceMinor       Int
  stockDecremented Int     @default(0)
}

model PaymentEvent {
  id          String        @id @default(uuid())
  orderId     String
  provider    PaymentMethod
  providerRef String
  amountMinor Int
  currency    String
  accepted    Boolean
  createdAt   DateTime      @default(now())

  @@unique([provider, providerRef])
}

model RefundOperation {
  id              String                @id @default(uuid())
  orderId         String
  order           Order                 @relation(fields: [orderId], references: [id])
  kind            RefundOperationKind
  status          RefundOperationStatus @default(REQUESTED)
  idempotencyKey  String                @unique
  providerRef     String?
  amountMinor     Int
  currency        String
  asset           String?
  network         String?
  destination     String?
  networkFeeMinor Int?
  txid            String?
  actor           String
  reason          String?
  errorMessage    String?
  reconciledAt    DateTime?             @db.Timestamptz(3)
  slaDueAt        DateTime              @db.Timestamptz(3)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([orderId, status])
}

model MessengerContact {
  id                      String            @id @default(uuid())
  platform                MessengerPlatform
  externalId              String
  customerId              String?
  lastAutoReplyAt         DateTime?
  isBlocked               Boolean           @default(false)
  phoneVerifiedAt         DateTime?         @db.Timestamptz(3)
  phoneVerificationMethod String?
  phoneRiskExpiresAt      DateTime?         @db.Timestamptz(3)
  otpCodeHash             String?
  otpExpiresAt            DateTime?         @db.Timestamptz(3)
  otpAttempts             Int               @default(0)
  requiresManualReview    Boolean           @default(false)
  unblockedBy             String?
  unblockReason           String?
  unblockedAt             DateTime?         @db.Timestamptz(3)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@unique([platform, externalId])
  @@index([customerId])
}

model EscalationTicket {
  id         String            @id @default(uuid())
  platform   MessengerPlatform
  senderId   String
  queryText  String?
  isResolved Boolean           @default(false)
  createdAt  DateTime          @default(now())
}

model KnowledgeChunk {
  id       String                   @id @default(uuid())
  source   String
  position Int
  content  String
  tsv      Unsupported("tsvector")?

  @@index([tsv], type: Gin)
}

model InboxEvent {
  id                  String         @id @default(uuid())
  provider            String
  eventId             String
  kind                InboxEventKind
  botProfile          String?
  chatId              String?
  priority            Int            @default(10)
  dedupeKey           String?        @unique
  payloadJson         Json
  status              InboxStatus    @default(PENDING)
  attemptCount        Int            @default(0)
  lastErrorAt         DateTime?      @db.Timestamptz(3)
  lockedAt            DateTime?      @db.Timestamptz(3)
  lockedBy            String?
  leaseExpiresAt      DateTime?      @db.Timestamptz(3)
  nextAttemptAt       DateTime?      @db.Timestamptz(3)
  reconciliationState String?
  createdAt           DateTime       @default(now())

  @@unique([provider, eventId])
  @@index([status, priority, nextAttemptAt])
  @@index([botProfile, chatId, status])
}

model TelegramRateState {
  id            String    @id
  botProfile    String
  chatId        String?
  cooldownUntil DateTime? @db.Timestamptz(3)
  windowStart   DateTime  @default(now()) @db.Timestamptz(3)
  sentCount     Int       @default(0)
  updatedAt     DateTime  @updatedAt

  @@index([botProfile, chatId])
}

// -------------------------------------------------------------
// Tier 2: Goods, Inventory & Commerce Models (003.2+ - T063)
// -------------------------------------------------------------

enum OfferingKind {
  PRODUCT
  SERVICE
  BUNDLE
  DIGITAL
  CUSTOM_QUOTE
}

enum PriceMode {
  FIXED
  STARTING_FROM
  QUOTE_REQUIRED
}

enum InventoryMovementKind {
  INITIAL
  RESERVE
  COMMIT
  RELEASE
  ADJUSTMENT
  RETURN
  DAMAGE
}

enum PaymentPlanStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMilestoneKind {
  DEPOSIT
  MILESTONE
  BALANCE
  ON_SITE
}

enum PaymentMilestoneStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  WAIVED
  REFUNDED
}

enum FulfillmentPlanStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PARTIALLY_COMPLETED
  CANCELLED
  REQUIRES_ATTENTION
}

enum FulfillmentSegmentKind {
  INVENTORY
  APPOINTMENT
  DIGITAL
  DELIVERY
  MANUAL_MILESTONE
}

enum FulfillmentSegmentStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

enum OperatorActionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OperatorActionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

model Offering {
  id            String            @id @default(uuid())
  legacyItemId  String?           @unique
  slug          String            @unique
  kind          OfferingKind      @default(PRODUCT)
  name          String
  description   String?
  active        Boolean           @default(true)
  taxCategoryId String?
  priceMode     PriceMode         @default(FIXED)
  variants      OfferingVariant[]
  servicePolicy ServicePolicy?
  bundleItems   BundleComponent[] @relation("ParentBundle")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([kind, active])
}

model OfferingVariant {
  id                    String              @id @default(uuid())
  offeringId            String
  offering              Offering            @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  sku                   String              @unique
  title                 String
  attributesJson        Json                @default("{}")
  unitAmountMinor       BigInt
  currency              String
  outCallPriceMinor     BigInt?
  outCallTravelFeeMinor BigInt              @default(0)
  starsPrice            Int?
  active                Boolean             @default(true)
  inventoryBalance      InventoryBalance?
  inventoryMovements    InventoryMovement[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([offeringId, active])
}

model ServicePolicy {
  id                      String   @id @default(uuid())
  offeringId              String   @unique
  offering                Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  durationMin             Int
  bufferBeforeMin         Int      @default(0)
  bufferAfterMin          Int      @default(0)
  cancellationCutoffHours Int      @default(3)
  inCallEnabled           Boolean  @default(true)
  outCallEnabled          Boolean  @default(false)
  outCallTravelBeforeMin  Int      @default(0)
  outCallTravelAfterMin   Int      @default(0)
}

model BundleComponent {
  id               String   @id @default(uuid())
  bundleOfferingId String
  bundleOffering   Offering @relation("ParentBundle", fields: [bundleOfferingId], references: [id], onDelete: Cascade)
  childOfferingId  String
  childVariantId   String?
  quantity         Decimal  @default(1)
}

model InventoryBalance {
  variantId String          @id
  variant   OfferingVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand    Int             @default(0)
  reserved  Int             @default(0)
  available Int             @default(0)
  updatedAt DateTime        @updatedAt
}

model InventoryMovement {
  id             String                @id @default(uuid())
  variantId      String
  variant        OfferingVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  orderId        String?
  kind           InventoryMovementKind
  quantityDelta  Int
  reason         String?
  markingCode    String?
  actorStaffId   String?
  idempotencyKey String                @unique
  createdAt      DateTime              @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
}

model OrderLine {
  id                   String       @id @default(uuid())
  orderId              String
  order                Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  legacyOrderItemId    String?      @unique
  offeringId           String?
  variantId            String?
  offeringKindSnapshot OfferingKind @default(PRODUCT)
  offeringNameSnapshot String
  variantNameSnapshot  String?
  quantity             Decimal      @default(1)
  unitAmountMinor      BigInt
  currency             String
  discountMinor        BigInt       @default(0)
  netAmountMinor       BigInt
  taxAmountMinor       BigInt       @default(0)
  grossAmountMinor     BigInt
  taxCategoryCode      String?
  taxRateSnapshot      Decimal?
  taxProviderReference String?
  durationMinSnapshot  Int?
  createdAt            DateTime     @default(now())

  @@index([orderId])
}

model PaymentPlan {
  id               String             @id @default(uuid())
  orderId          String             @unique
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  currency         String
  totalAmountMinor BigInt
  paidAmountMinor  BigInt             @default(0)
  status           PaymentPlanStatus  @default(PENDING)
  milestones       PaymentMilestone[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model PaymentMilestone {
  id              String                 @id @default(uuid())
  paymentPlanId   String
  paymentPlan     PaymentPlan            @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  sequence        Int                    @default(1)
  kind            PaymentMilestoneKind
  title           String
  amountMinor     BigInt
  paidAmountMinor BigInt                 @default(0)
  dueAt           DateTime?
  status          PaymentMilestoneStatus @default(PENDING)
  allocations     PaymentAllocation[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([paymentPlanId, sequence])
}

model PaymentAllocation {
  id                String           @id @default(uuid())
  milestoneId       String
  milestone         PaymentMilestone @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  paymentEventId    String?
  refundOperationId String?
  allocatedMinor    BigInt
  currency          String
  createdAt         DateTime         @default(now())

  @@index([milestoneId])
  @@index([paymentEventId])
  @@index([refundOperationId])
}

model FulfillmentPlan {
  id        String                @id @default(uuid())
  orderId   String                @unique
  order     Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    FulfillmentPlanStatus @default(PENDING)
  segments  FulfillmentSegment[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model FulfillmentSegment {
  id                  String                   @id @default(uuid())
  fulfillmentPlanId   String
  fulfillmentPlan     FulfillmentPlan          @relation(fields: [fulfillmentPlanId], references: [id], onDelete: Cascade)
  orderLineId         String?
  kind                FulfillmentSegmentKind
  providerMode        String                   @default("SERVICE_ON_SITE")
  status              FulfillmentSegmentStatus @default(PENDING)
  assignedStaffId     String?
  reservationId       String?
  inventoryMovementId String?
  scheduledStartAt    DateTime?
  scheduledEndAt      DateTime?
  completedAt         DateTime?
  evidence            CompletionEvidence[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([fulfillmentPlanId])
  @@index([assignedStaffId, status])
}

model CompletionEvidence {
  id                   String             @id @default(uuid())
  fulfillmentSegmentId String
  fulfillmentSegment   FulfillmentSegment @relation(fields: [fulfillmentSegmentId], references: [id], onDelete: Cascade)
  performerStaffId     String
  notes                String?
  serialNumber         String?
  mediaUrlsJson        Json               @default("[]")
  checklistJson        Json               @default("{}")
  customerConfirmedAt  DateTime?
  createdAt            DateTime           @default(now())

  @@index([fulfillmentSegmentId])
}

model OperatorAction {
  id                    String                 @id @default(uuid())
  dedupeKey             String                 @unique
  reason                String
  severity              OperatorActionSeverity @default(HIGH)
  status                OperatorActionStatus   @default(OPEN)
  affectedAggregateType String
  affectedAggregateId   String
  recommendedNextAction String
  availableSafeActions  Json                   @default("[]")
  ownerStaffId          String?
  dueAt                 DateTime?
  resolution            String?
  resolvedByStaffId     String?
  resolvedByRole        StaffRole?
  resolvedAt            DateTime?
  auditHistory          Json                   @default("[]")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([status, severity, dueAt])
  @@index([affectedAggregateType, affectedAggregateId])
}

// ============================================================
// 004 Release Readiness — new tables (Phase 1 Expand, data-model §1.3–1.9)
// ============================================================

/// Waitlist auto-fill entry (US5, FR-419/420). PII: customerTgId/customerContact.
model WaitlistEntry {
  id                    String              @id @default(uuid())
  customerTgId          String
  customerContact       String?
  serviceId             String?
  service               Item?               @relation(fields: [serviceId], references: [id])
  professionalProfileId String?
  windowStartAt         DateTime            @db.Timestamptz(3)
  windowEndAt           DateTime            @db.Timestamptz(3)
  status                WaitlistEntryStatus @default(ACTIVE)
  createdAt             DateTime            @default(now())
  offers                WaitlistOffer[]

  @@unique([customerTgId, serviceId, windowStartAt])
  @@index([status, windowStartAt])
}

enum WaitlistEntryStatus {
  ACTIVE
  NOTIFIED
  FULFILLED
  EXPIRED
  CANCELLED
}

/// Waitlist offer (US5). Token stored as SHA-256 hash; atomic claim via standard booking path.
model WaitlistOffer {
  id                String              @id @default(uuid())
  waitlistEntryId   String
  waitlistEntry     WaitlistEntry       @relation(fields: [waitlistEntryId], references: [id])
  slotReservationId String?
  slotReservation   SlotReservation?    @relation(fields: [slotReservationId], references: [id])
  offerTokenHash    String              @unique
  status            WaitlistOfferStatus @default(SENT)
  sentAt            DateTime            @default(now())
  claimedAt         DateTime?           @db.Timestamptz(3)

  @@index([status, sentAt])
}

enum WaitlistOfferStatus {
  SENT
  CLAIMED
  TAKEN
  EXPIRED
}

/// Custom booking field definition (US6, FR-423/434). Archive-only lifecycle.
model CustomBookingField {
  id           String               @id @default(uuid())
  key          String               @unique
  label        String
  type         CustomFieldType
  required     Boolean              @default(false)
  optionsJson  Json?
  boundItemIds String[]
  sortOrder    Int                  @default(0)
  archivedAt   DateTime?            @db.Timestamptz(3)
  createdAt    DateTime             @default(now())
  answers      BookingFieldAnswer[]
  Item         Item?                @relation(fields: [itemId], references: [id])
  itemId       String?

  @@index([archivedAt])
}

enum CustomFieldType {
  TEXT
  NUMBER
  SINGLE_SELECT
  CHECKBOX
}

/// Customer answer to a custom field, with immutable definition snapshot (PII).
model BookingFieldAnswer {
  id                   String              @id @default(uuid())
  slotReservationId    String
  slotReservation      SlotReservation     @relation(fields: [slotReservationId], references: [id])
  fieldId              String
  labelSnapshot        String
  typeSnapshot         CustomFieldType
  valueText            String?             @db.Text
  valueNumber          Int?
  valueBool            Boolean?
  CustomBookingField   CustomBookingField? @relation(fields: [customBookingFieldId], references: [id])
  customBookingFieldId String?

  @@unique([slotReservationId, fieldId])
}

/// Notification delivery log (US2, FR-409). Target stored as salted hash, never raw PII.
model NotificationDeliveryLog {
  id           String                     @id @default(uuid())
  bookingRefId String?
  orderId      String?
  channel      NotificationChannel
  targetHash   String
  status       NotificationDeliveryStatus
  providerRef  String?
  errorCode    String?
  attemptAt    DateTime                   @default(now())
  latencyMs    Int?

  @@index([attemptAt])
}

enum NotificationChannel {
  TELEGRAM
  EMAIL
}

enum NotificationDeliveryStatus {
  ACCEPTED
  FAILED
}

/// 301 slug redirect for renamed professional profiles (US9, FR-437).
model SlugRedirect {
  oldSlug   String   @id
  profileId String
  createdAt DateTime @default(now())
}

/// Explicit payment-provider ledger link (data-model 1.2; pre-structure for 003.2 PaymentAllocation).
model PaymentAllocationLink {
  id                String           @id @default(uuid())
  orderId           String
  order             Order?           @relation(fields: [orderId], references: [id])
  provider          String
  providerPaymentId String
  allocationKind    String
  createdAt         DateTime         @default(now())
  SlotReservation   SlotReservation? @relation(fields: [slotReservationId], references: [id])
  slotReservationId String?

  @@unique([provider, providerPaymentId])
}

/// Customer language preference (US3, FR-412). Resolution: override > language_code > instance default.
model UserPreference {
  tgId             String   @id
  languageOverride String?
  updatedAt        DateTime @updatedAt
}

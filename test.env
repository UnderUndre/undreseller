NODE_OPTIONS="--no-deprecation --no-experimental-strip-types"

# GUARD (code F-05): this file is git-tracked and must contain ONLY local docker
# defaults — real secrets live in .env (gitignored). CI greps this file for stray keys.
# Test DB isolation (spec 001-reinit FR-108, research D4) — loaded by vitest.setup.ts
# with OVERRIDE priority over .env, so integration tests NEVER touch the dev DB.
#
# One-time bootstrap (idempotent):
#   docker exec undreseller_db psql -U postgres -c "SELECT 1 FROM pg_database WHERE datname='undreseller_test'" | grep -q 1 || \
#   docker exec undreseller_db psql -U postgres -c "CREATE DATABASE undreseller_test"
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/undreseller_test

# Database connection strings (pooled and direct)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/undreseller?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/undreseller?schema=public"

# Admin Authentication
ADMIN_TOKEN="test_admin_token_secret_1234567890"
ADMIN_OLD_TOKEN_EXPIRES_AT=""
ADMIN_CHAT_ID="12345678"

# Sprint B Integration Profile (NONE | TELEGRAM_BUNDLE | WHATSAPP | NOWPAYMENTS)
ENABLED_EXTERNAL_INTEGRATION="TELEGRAM_BUNDLE"

# Telegram Client Bot & Dedicated Staff Bot (TELEGRAM_BUNDLE contour)
TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
TELEGRAM_WEBHOOK_SECRET="test_telegram_secret"
STAFF_BOT_TOKEN="654321:STAFF-BOT-DEF1234ghIkl-zyx57W2v1u123"
STAFF_WEBHOOK_SECRET="test_staff_webhook_secret"
STAFF_CHAT_ID="-1001234567890"
# Telegram user IDs мастеров, допущенных к кнопкам (через запятую). Fallback для authorizedStaffUserIds из БД.
STAFF_AUTHORIZED_IDS=""

# WhatsApp Cloud API (only when ENABLED_EXTERNAL_INTEGRATION="WHATSAPP")
WHATSAPP_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# NOWPayments Crypto Gateway (only when ENABLED_EXTERNAL_INTEGRATION="NOWPAYMENTS")
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# AI Knowledge Engine
AI_MODEL="gemini-2.5-flash"
AI_FALLBACK_MODEL="gpt-4o-mini"
AI_API_KEY="test_ai_api_key"

# Topology
REPLICA_COUNT="1"
NEXT_PUBLIC_APP_URL="https://demo.undreseller.com"

# Inngest (self-hosted or Cloud). INNGEST_EVENT_KEY требуется для входящих событий из SDK.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
INNGEST_BASE_URL=""

# Better Auth Configuration (Staff Identity & Session Management - 003.1)
BETTER_AUTH_SECRET="change_me_to_a_random_32_byte_secret_key"
BETTER_AUTH_URL="http://localhost:3000"

# Initial Staff Bootstrap (Optional for scripts/bootstrap-owner.ts)
BOOTSTRAP_OWNER_EMAIL="owner@example.com"
BOOTSTRAP_OWNER_PASSWORD=""
BOOTSTRAP_OWNER_NAME="Business Owner"
